# ==============================================
# REQUIRED VARIABLES
# These must be set for the pipeline to work
# ==============================================

# SLURM Account (required, can be overridden via CLI)
SLURM_ACCOUNT=                  # Your SLURM account with GPU access 

# ==============================================
# OPTIONAL VARIABLES
# These have defaults or can be overridden
# ==============================================

# Workspace root (default: current working directory)
# All other directories, caches, and SLURM job files default to paths under this.
# On HPC clusters, set this to a filesystem visible to compute nodes (e.g. /scratch/<project>/<user>/llmflux)
LLMFLUX_WORKSPACE=

# Base Directories (default: {workspace}/<name>, created automatically if missing)
LLMFLUX_DATA_DIR=               # Default: {workspace}/data
LLMFLUX_DATA_INPUT_DIR=         # Default: {LLMFLUX_DATA_DIR}/input (for JSON input files)
LLMFLUX_DATA_OUTPUT_DIR=        # Default: {LLMFLUX_DATA_DIR}/output (for generated responses)
LLMFLUX_MODELS_DIR=             # Default: {workspace}/models (for model cache)
LLMFLUX_LOGS_DIR=               # Default: {workspace}/logs (for all log files)
LLMFLUX_CONTAINERS_DIR=         # Default: {workspace}/containers (for Apptainer images)

# Container Configuration
CONTAINER_NAME=llm_processor    # Default: llm_processor (Apptainer container name)

# SLURM Defaults (can be overridden by model requirements)
SLURM_PARTITION=gpuA100x4      # Default: A100 GPU partition
SLURM_TIME=00:30:00           # Default: 30 minutes runtime
SLURM_CPUS_PER_TASK=4         # Default: 4 CPU cores (overridden by model config)

# Multi-Node Inference (vLLM only; see docs/MULTINODE.md)
# All optional — every value below has a working default.
LLMFLUX_SERVER_TIMEOUT=       # Default: 300 single-node / 1800 multi-node. Seconds
                              # to wait for the server to become ready. On
                              # multi-node, clamped to 90% of the allocation's
                              # remaining walltime.
LLMFLUX_RANK_START_TIMEOUT=   # Default: 300. Seconds to wait for every rank to
                              # reach its launcher before failing with diagnostics.
LLMFLUX_HSN_IFACE=            # Default: hsn. Fabric interface name, or a prefix
                              # matched as <prefix><digits> so VLAN children
                              # (e.g. hsn0.561) are excluded. The default suits
                              # HPE Slingshot; elsewhere set it to ib, eth, etc.
LLMFLUX_NCCL_SOCKET_IFNAME=   # Default: derived from the node. Comma-separated
                              # interface list for NCCL.
LLMFLUX_RDZV_PORT=            # Default: 29500. Starting port for the rendezvous.
LLMFLUX_PORT_SCAN_MAX=        # Default: 64. How far above LLMFLUX_RDZV_PORT to
                              # scan for a free port.
LLMFLUX_SYMM_MEM=             # Default: 0. Sets VLLM_ALLREDUCE_USE_SYMM_MEM.
                              # vLLM defaults it on; it deadlocks cross-node
                              # during engine init.

# Ollama Configuration
OLLAMA_TIMEOUT=300            # Default: 5 minutes timeout for requests

# API key for an `llmflux serve` endpoint (get it from `llmflux connect <job_id>`)
# Sent as a bearer token by LLMClient/BatchProcessor; unset means no auth header.
# Leave this commented out unless you are pinning a key here: the loader runs with
# override=True, so a blank `LLMFLUX_API_KEY=` line erases a key exported in your shell.
# LLMFLUX_API_KEY=

# LLM client request timeouts (applied to every LLMClient request)
LLMFLUX_CONNECT_TIMEOUT=10    # Default: 10 seconds to establish a connection
LLMFLUX_READ_TIMEOUT=600      # Default: 600 seconds to read a response. Generous
                              # because a long completion legitimately takes
                              # minutes; it only has to be finite.

# HuggingFace Configuration (optional, for accessing gated models)
# Your HuggingFace API token (get from https://huggingface.co/settings/tokens)
HUGGINGFACE_TOKEN=hf_XXXXXXXXXXXXXXX
# HuggingFace cache directory (used by vLLM; default: {workspace}/.cache/huggingface)
HF_HOME=

# Logging Configuration (used by batch processor)
LOG_LEVEL=info                # Default: info (options: debug, info, warning, error)
LOG_FORMAT=json               # Default: json (options: json, text)
LOG_MAX_SIZE=100M             # Default: 100M (use K, M, or G suffix)
LOG_MAX_FILES=5               # Default: 5 rotated log files

# vLLM Engine Arguments
VLLM_ENGINE_ARGS={"max-model-len":8192,"trust-remote-code":true}

# ==============================================
# NOTES
# ==============================================
# 1. Only SLURM_ACCOUNT is required, everything else has defaults
# 2. Directories will be created automatically if they don't exist
# 3. Model-specific settings are in config/models/<model>/<size>.yaml
# 4. Unset directories default to paths under LLMFLUX_WORKSPACE
# 5. Override any setting via environment variables when running
# 6. Path precedence: code paths > environment variables > defaults
